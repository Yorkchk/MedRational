
#   .env.dev   local Supabase in Docker + dev R2 bucket
#   .env.uat   uat Supabase cloud project + uat R2 bucket
#   .env.prod  prod Supabase cloud project + prod R2 bucket
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
SUPABASE_DB_DATABASE=
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=

DB_POOL_SIZE=


JWT_SECRET=

# Cloudflare R2 file storage.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
# Defaults: "dev" in dev, "uat" in uat; required in prod
R2_BUCKET=

# Amazon SES SMTP for one-time codes and workshop emails
#   MAIL_HOST      email-smtp.<region>.amazonaws.com (the region where the identity is verified)
#   MAIL_PORT      587 (STARTTLS)
#   MAIL_USERNAME  / MAIL_PASSWORD  SES SMTP credentials (SES console -> SMTP settings), not the IAM secret key
#   MAIL_FROM      a verified SES identity, e.g. SWISRA <no-reply@example.com>
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Push notifications
FIREBASE_CREDENTIALS=
WORKSHOPS_PUSH_TOPIC=

# LibreOffice install dir for Office previews
LIBREOFFICE_HOME=
