# HTTPS in front of the API. DOMAIN comes from the server's .env through compose.yml.
# Caddy gets and renews the Let's Encrypt certificate on its own and redirects HTTP to HTTPS.
{$DOMAIN} {
	encode zstd gzip

	# Spring allows 50 MB per request (spring.servlet.multipart.max-request-size); a little more
	# here for the multipart overhead, so Spring answers the 413s the app knows how to show.
	request_body {
		max_size 55MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy api:8080
}
