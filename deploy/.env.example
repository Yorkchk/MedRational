# Template for /opt/medrational/.env on the server: copy it to deploy/.env (git-ignored) and fill it in.
# Not secret: it only picks the environment. The secrets stay in .env.<APP_ENV> (.env.uat or .env.prod).

# prod or uat: picks the Spring profile and the .env.<APP_ENV> file
APP_ENV=uat

# api.swisra.app (prod) or uat.swisra.app (uat); Caddy gets its certificate for this name
DOMAIN=uat.swisra.app

# A tag from the "Publish image" run summary: sha- plus the full commit hash. Pin one in prod,
# never latest; rolling back is setting the previous tag and running docker compose up -d.
IMAGE_TAG=sha-<full commit hash>
